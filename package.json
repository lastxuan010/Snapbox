{
  "name": "media-archive",
  "version": "1.0.0",
  "description": "A dark-glass media archive manager for Windows desktop.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win"
  },
  "author": "TraeDesign",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.traedesign.media-archive",
    "productName": "Media Archive",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "archiver": "^6.0.2",
    "codemirror": "^6.0.2"
  }
}
