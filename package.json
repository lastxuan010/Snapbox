{
  "name": "media-archive",
  "version": "1.0.0",
  "description": "A dark-glass media archive manager for Windows desktop.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win",
    "build:office": "esbuild src-office/office-entry.js --bundle --format=iife --minify --platform=browser --outfile=office.bundle.js"
  },
  "author": "TraeDesign",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.traedesign.media-archive",
    "productName": "Media Archive",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/app-icon.png",
      "target": "nsis"
    }
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "archiver": "^6.0.2",
    "codemirror": "^6.0.2",
    "docx-preview": "^0.4.0",
    "pptx-preview": "^1.0.7",
    "xlsx": "^0.18.5"
  }
}
